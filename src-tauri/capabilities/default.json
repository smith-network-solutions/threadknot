{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "All windows (main + per-project solo): core APIs + folder-picker dialog + system-browser link opening",
  "windows": [
    "main",
    "project-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    }
  ]
}
